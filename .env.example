# Copie para .env e preencha. Nenhum valor abaixo é um segredo utilizável.
# Gere segredos com, por exemplo:  openssl rand -base64 32

# ── Usados pelo docker-compose ──────────────────────────────────────────────
POSTGRES_USER=condoguard
POSTGRES_PASSWORD=
POSTGRES_DB=condoguard
REDIS_PASSWORD=
JWT_SECRET_KEY=

# ── Usados pela API rodando fora do container (make run) ───────────────────
# DATABASE_URL=postgres://condoguard:<POSTGRES_PASSWORD>@localhost:5432/condoguard?sslmode=disable
# Opcional: papel dono do esquema só para as migrações; a API roda com o DATABASE_URL, sem DDL.
# DATABASE_MIGRATIONS_URL=postgres://<dono>:<senha>@localhost:5432/condoguard?sslmode=disable
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
PORT=8080
DB_MIGRATE_ON_START=true

# Condomínio (tenant) usado em todas as consultas até a entidade condomínio
# existir (Fase 1b).
DEFAULT_CONDOMINIUM_ID=default

# Limite de tentativas de login com falha por IP + e-mail e por IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=50
LOGIN_LOCKOUT_WINDOW=15m

# Limite de cadastros (POST /auth/register) por IP na janela.
REGISTER_MAX_PER_IP=10
REGISTER_WINDOW=1h

# Origens do web, separadas por vírgula. "*" é recusado (cookies com credenciais).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sessão: access token curto e refresh token rotativo (cookie httpOnly no web).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# false só em HTTP puro fora de localhost; em produção sempre true.
COOKIE_SECURE=true
# Vazio = cookie só para o host da API. Em produção, se web e API estão em
# subdomínios diferentes, use o domínio comum (ex.: condoguard.com.br) para o
# middleware.ts do web enxergar o cookie de sessão.
COOKIE_DOMAIN=
# Se um proxy expõe a API num subcaminho (ex.: Caddy em /api/*), informe o
# prefixo: o cookie de refresh vai para <prefixo>/auth, que é o caminho que o
# navegador usa. Vazio = API na raiz.
COOKIE_PATH_PREFIX=

# Bearer exigido em /metrics (mínimo 32 caracteres). Vazio = /metrics desligado.
METRICS_TOKEN=

# Fora do compose (banco em outro host), use sslmode=require ou verify-full
# no DATABASE_URL; sslmode=disable só vale para o banco na mesma máquina.
